flowchart TD
    %% Base Model Loading
    A[UnetLoaderGGUF] -->|Miraclein_4.3_9b_q8_0.gguf| B[LoraLoaderModelOnly]
    B -->|refcontrol_v2_poses_flux2_klein.safetensors| C[LoraLoaderModelOnly]
    C -->|klein_slider_anatomy.safetensors| D[LoraLoaderModelOnly]
    D -->|instapic_V5_flux_klein.safetensors| E[LoraLoaderModelOnly]
    E -->|Portrait Engine - Flux2 Klein 4.0.safetensors| F[AdvancedOpenposeLoader]

    %% Text Conditioning
    G[CLIPLoaderGGUF] -->|flux2-klein-qwen3-q8_0.gguf| H[CLIPTextEncode]
    H -->|prompt text| F

    %% VAE (loaded internally by AdvancedOpenposeLoader)
    I[VAELoader] -->|flux2-vae.safetensors| J[VAEDecode]

    %% AdvancedOpenposeLoader (replaces complex ControlNet subgraph)
    F -->|model| K[KSampler]
    F -->|positive conditioning| K
    F -->|negative conditioning| K

    %% Empty Latent
    L[EmptyLatentImage] -->|1024x1024| K

    %% Sampling
    K -->|latent| J

    %% Output
    J -->|image| M[SaveImage]

    %% Pose folder structure - single folder with all pose asset variants
    %% Each pose type has its own image file, loaded and encoded separately
    subgraph PoseAssets["poses/{pose_id}/ folder"]
        direction TB
        N[openpose.png]
        O[openpose_hand.png]
        P[openpose_full.png]
        Q[canny.png]
        R[depth.png]
        S[normal.png]
    end

    %% Folder connects to AdvancedOpenposeLoader
    PoseAssets -->|folder_name input| F

    %% File processing chain for each pose type
    subgraph PoseProcessing["Pose Image Processing (per type)"]
        direction LR
        U[PIL Image Load] --> V[Resize 1024x1024] --> W[VAE Encode] --> X[Reference Latents] --> Y[Control Context] --> Z[ControlNet Apply]
    end

    F -->|calls internally| PoseProcessing

    %% Six ControlNet strength controls (piped one into another)
    subgraph StrengthControls["ControlNet Strength Controls"]
        direction TB
        T1[strength_openpose: 0.75]
        T1 --> T2
        T2[strength_openpose_hand: 0.80]
        T2 --> T3
        T3[strength_openpose_full: 0.85]
        T3 --> T4
        T4[strength_canny: 0.0]
        T4 --> T5
        T5[strength_depth: 0.0]
        T5 --> T6
        T6[strength_normal: 0.0]
    end

    StrengthControls -->|applied internally| F

    %% Node details
    click F href "advanced_openpose_loader.py" "AdvancedOpenposeLoader node code"
    click PoseAssets href "poses/" "Pose assets"